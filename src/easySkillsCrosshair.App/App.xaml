<Application x:Class="easySkillsCrosshair.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:easySkillsCrosshair.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
