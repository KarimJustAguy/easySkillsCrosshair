<UserControl x:Class="easySkillsCrosshair.App.Views.AimTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:easySkillsCrosshair.App.ViewModels"
             xmlns:controls="clr-namespace:easySkillsCrosshair.App.Controls"
             xmlns:render="clr-namespace:easySkillsCrosshair.Overlay.Rendering;assembly=easySkillsCrosshair.Overlay"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:AimTrainingViewModel}"
             Background="{StaticResource Brush.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Controls bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Modes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AimModeOption}">
                                <Button Content="{Binding DisplayName}" ToolTip="{Binding Description}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Small}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <controls:ProGateControl IsLocked="{Binding IsTrialPreview}">
                        <StackPanel>
                            <TextBlock Text="{Binding DurationMinutes, StringFormat='Dauer: {0:0.#} min'}" Style="{StaticResource Text.Muted}" />
                            <Slider Style="{StaticResource Slider.Gold}" Minimum="0.5" Maximum="30" Value="{Binding DurationMinutes}"
                                    MaxWidth="260" HorizontalAlignment="Left" Width="260" />
                        </StackPanel>
                    </controls:ProGateControl>
                    <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" Style="{StaticResource Button.Primary}" Width="90" Command="{Binding StartCommand}" />
                    <Button Content="Stopp" Style="{StaticResource Button.Base}" Width="90" Margin="8,0,0,0" Command="{Binding StopCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arena -->
        <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Grid x:Name="ArenaHost" Background="Transparent" Cursor="None">
                <controls:AimArenaElement x:Name="Arena" />
                <Canvas IsHitTestVisible="False">
                    <render:CrosshairVisual x:Name="CursorVisual" Width="96" Height="96" Visibility="Hidden" />
                </Canvas>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Schießstand" Style="{StaticResource Heading1}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AccessLevelText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource Brush.Gold}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Modus wählen und „Start“ drücken. Getestet wird dein aktuelles Fadenkreuz."
                               Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ZEIT" Style="{StaticResource Label.Section}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding RemainingText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Gold}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="SCORE" Style="{StaticResource Label.Section}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Score}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TREFFER" Style="{StaticResource Label.Section}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Hits}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="PRÄZISION" Style="{StaticResource Label.Section}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding AccuracyText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Ø REAKTION" Style="{StaticResource Label.Section}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ReactionText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
