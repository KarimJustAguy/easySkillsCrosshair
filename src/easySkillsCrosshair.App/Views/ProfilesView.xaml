<UserControl x:Class="easySkillsCrosshair.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:easySkillsCrosshair.App.ViewModels"
             xmlns:controls="clr-namespace:easySkillsCrosshair.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
             Background="{StaticResource Brush.Background}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Profile" Style="{StaticResource Heading1}" Margin="0,0,0,4" />
            <TextBlock Text="Per-Game-Profile speichern und laden." Style="{StaticResource Text.Muted}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource TextBox.Dark}"
                         Text="{Binding NewGameName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Button.Primary}"
                        Content="Aktuelles speichern" Command="{Binding SaveCurrentAsCommand}" />
            </Grid>
        </Border>

        <!-- Scrollable: the profile list grows unbounded and used to overflow the view. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="200" Margin="0,0,16,16">
                        <StackPanel>
                            <controls:CrosshairPreviewControl Profile="{Binding Crosshair}" Height="120" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding GameName}" Style="{StaticResource Heading2}" />
                            <TextBlock Text="{Binding Crosshair.Name}" Style="{StaticResource Text.Muted}" Margin="0,2,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Aktivieren" Style="{StaticResource Button.Primary}"
                                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="1" Content="Löschen" Style="{StaticResource Button.Icon}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
