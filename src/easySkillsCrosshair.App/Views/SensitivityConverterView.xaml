<UserControl x:Class="easySkillsCrosshair.App.Views.SensitivityConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:easySkillsCrosshair.App.ViewModels"
             xmlns:sens="clr-namespace:easySkillsCrosshair.Core.Sensitivity;assembly=easySkillsCrosshair.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SensitivityConverterViewModel}"
             Background="{StaticResource Brush.Background}">
    <UserControl.Resources>
        <DataTemplate x:Key="GameItemTemplate" DataType="{x:Type sens:GameSensitivityProfile}">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Sensitivity Converter" Style="{StaticResource Heading1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,20"
                       Text="Rechnet deine Sensitivity zwischen Spielen um — gleiche Mausdistanz für eine 360°-Drehung, gleiches Muskelgedächtnis." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{StaticResource Brush.Danger}"
                    Visibility="{Binding HasCatalogWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CatalogWarning}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
            </Border>

            <!-- ===================== From / To ===================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VON" Style="{StaticResource Label.Section}" />
                        <ComboBox Style="{StaticResource ComboBox.Gold}" ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding FromGame}" ItemTemplate="{StaticResource GameItemTemplate}"
                                  MaxDropDownHeight="360" Margin="0,0,0,14" />

                        <TextBlock Text="Sensitivity" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Dark}" Margin="0,0,0,12"
                                 Text="{Binding SensitivityInput, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="DPI" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Dark}"
                                 Text="{Binding DpiFromInput, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsFromCustom, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Eigener Faktor (Yaw)" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Dark}"
                                     Text="{Binding CustomYawFromInput, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource Button.Base}" Width="46" Height="46" Padding="0"
                            Margin="18,26,18,0" VerticalAlignment="Top" ToolTip="Quelle und Ziel tauschen"
                            Command="{Binding SwapCommand}">
                        <Path Data="M2,6 L16,6 M12,2 L16,6 L12,10 M22,16 L8,16 M12,12 L8,16 L12,20" Width="18" Height="18"
                              Stretch="Uniform" Stroke="{StaticResource Brush.Gold}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ZU" Style="{StaticResource Label.Section}" />
                        <ComboBox Style="{StaticResource ComboBox.Gold}" ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding ToGame}" ItemTemplate="{StaticResource GameItemTemplate}"
                                  MaxDropDownHeight="360" Margin="0,0,0,14" />

                        <TextBlock Text="DPI" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource TextBox.Dark}"
                                 Text="{Binding DpiToInput, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsToCustom, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Eigener Faktor (Yaw)" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Dark}"
                                     Text="{Binding CustomYawToInput, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Result ===================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{StaticResource Brush.GoldMuted}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label.Section}">
                            <Run Text="DEINE SENSITIVITY IN " /><Run Text="{Binding ToGame.Name, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ResultText}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Brush.Gold}" />
                        <TextBlock Text="{Binding PrecisionHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasPrecisionHint, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Kopieren" Style="{StaticResource Button.Primary}" Width="110" Command="{Binding CopyResultCommand}" />
                        <TextBlock Text="{Binding CopyStatus}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Details ===================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="DETAILS" Style="{StaticResource Label.Section}" />
                    <UniformGrid Columns="5" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Exakt" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding ExactResultText}" Style="{StaticResource Heading2}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="cm / 360°" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding Cm360Text}" Style="{StaticResource Heading2}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="inch / 360°" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding In360Text}" Style="{StaticResource Heading2}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="eDPI Quelle" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding EdpiFromText}" Style="{StaticResource Heading2}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="eDPI Ziel" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding EdpiToText}" Style="{StaticResource Heading2}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="{Binding FromGame.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding FromNote, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="{Binding ToGame.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding ToNote, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" FontSize="11"
                               Text="eDPI ist nur innerhalb desselben Spiels vergleichbar. Sichtfeld (FOV), Seitenverhältnis und Spielgefühl können trotz exakt gleicher 360°-Distanz unterschiedlich wirken. Faktoren lassen sich in Data\games.json neben der exe ergänzen oder korrigieren." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
